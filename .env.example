# Every variable is optional. With none set, FLIGHTDECK runs on public Bitget
# data and keeps its ledger and logbook in the browser.

# --- Bitget trading (operator's own key) -------------------------------------
# A DEMO trading key (Bitget > Demo Trading > API). After a Tower clearance in
# Live mode, the order is placed on Bitget demo trading.
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
# Leave as "demo". Real-money orders stay off unless you set this to "live".
BITGET_TRADING_MODE=demo

# --- The crew and Night Watch model ------------------------------------------
# Any OpenAI-compatible chat endpoint.
# Hackathon Qwen proxy: https://hackathon.bitgetops.com/v1 with qwen3.6-plus
# Any OpenAI-compatible endpoint works. Examples:
#   Gemini: the OpenAI-compatible base URL from Google's Gemini API docs, and a Gemini model name.
#   Claude: Anthropic's API base URL ending in /v1, and a Claude model name.
# (The literal URLs are left out on purpose: Netlify fails a build when a file in
# the repo contains the value of one of the site's environment variables.)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Storage: Cloudflare D1 (same three names Lunaris uses) --------------------
# Enables the public ledger mirror, shareable pass links, and Night Watch with
# the browser closed. Tables are prefixed fd_, so an existing database is safe.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
# For a local run without Cloudflare: FLIGHTDECK_STORE=memory

# --- Protection ---------------------------------------------------------------
# The schedule that calls /api/watch must send this as "Authorization: Bearer ...".
CRON_SECRET=
# If set, every write to the server must carry it in the x-operator-key header.
FLIGHTDECK_OPERATOR_KEY=

# --- Earnings dates -----------------------------------------------------------
# Replace or add dates without a redeploy of the code:
# EARNINGS_JSON={"COINUSDT":{"date":"2026-10-29","announced":true}}
EARNINGS_JSON=
